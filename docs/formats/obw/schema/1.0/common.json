{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Weyoune/openbmh/main/docs/formats/obw/schema/1.0/common.json",
  "$defs": {
    "localized": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string"
        }
      },
      "required": [
        "default"
      ],
      "additionalProperties": true
    },
    "nation_id": {
      "type": "string",
      "pattern": "^nation:[a-zA-Z0-9._-]+$"
    },
    "team_id": {
      "type": "string",
      "pattern": "^(club|nt):[a-zA-Z0-9._-]+$"
    },
    "person_id": {
      "type": "string",
      "pattern": "^(player|staff):[a-zA-Z0-9._-]+$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    }
  },
  "$comment": "SPDX-License-Identifier: GPL-3.0-only; initial legacy-database-v1 conversion profile."
}
