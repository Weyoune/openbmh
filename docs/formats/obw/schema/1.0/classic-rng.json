{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Weyoune/openbmh/main/docs/formats/obw/schema/1.0/classic-rng.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "classic-rng@1.0"
    },
    "watcom": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "calls": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        }
      },
      "required": [
        "seed",
        "calls"
      ],
      "additionalProperties": false
    },
    "game": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "calls": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        }
      },
      "required": [
        "seed",
        "calls"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "watcom",
    "game"
  ],
  "additionalProperties": false
}
