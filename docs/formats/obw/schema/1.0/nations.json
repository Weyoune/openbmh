{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Weyoune/openbmh/main/docs/formats/obw/schema/1.0/nations.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "nations@1.0"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^nation:[a-zA-Z0-9._-]+$"
          },
          "name": {
            "$ref": "common.json#/$defs/localized"
          },
          "confederation": {
            "enum": [
              "uefa",
              "conmebol",
              "caf",
              "afc",
              "concacaf",
              "ofc",
              "other"
            ]
          },
          "national_team": {
            "type": "string",
            "pattern": "^nt:[a-zA-Z0-9._-]+$"
          },
          "playable": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "confederation"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema",
    "items"
  ],
  "additionalProperties": true,
  "$comment": "SPDX-License-Identifier: GPL-3.0-only; initial legacy-database-v1 conversion profile."
}
