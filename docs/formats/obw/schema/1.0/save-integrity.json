{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Weyoune/openbmh/main/docs/formats/obw/schema/1.0/save-integrity.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "save-integrity@1.0"
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "schema",
    "entries"
  ],
  "additionalProperties": false
}
