            "minItems": 2,
            "maxItems": 2
          },
          "phase": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "ended": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "kickoff_void_mask": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
