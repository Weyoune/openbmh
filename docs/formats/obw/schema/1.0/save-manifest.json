{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Weyoune/openbmh/main/docs/formats/obw/schema/1.0/save-manifest.json",
  "type": "object",
  "required": [
    "format",
    "format_version",
    "kind",
    "save_profile",
    "content_id"
  ],
  "properties": {
    "format": {
      "const": "openbmh-world"
    },
    "format_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "save"
    },
    "save_profile": {
      "const": "classic-career-v1"
    },
    "content_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true
}
