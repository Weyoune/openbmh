{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbmh.org/schema/1.1/editor-world.json",
  "title": "OBW 1.1 editor-world-v1 manifest",
  "type": "object",
  "required": ["format", "format_version", "min_reader", "kind", "title", "requires", "x-editor"],
  "properties": {
    "format": {"const": "openbmh-world"},
    "format_version": {"const": "1.1"},
    "min_reader": {"const": "1.1"},
    "kind": {"const": "world"},
    "title": {"oneOf": [{"type": "string"}, {"type": "object", "additionalProperties": {"type": "string"}}]},
    "start_date": {"type": "string", "format": "date"},
    "requires": {"type": "array", "contains": {"const": "editor:world-v1"}, "items": {"type": "string"}},
    "x-editor": {
      "type": "object", "required": ["profile", "playable"],
      "properties": {"profile": {"const": "editor-world-v1"}, "playable": {"const": false}},
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$defs": {
    "table": {"type": "object", "required": ["schema", "items"], "properties": {"schema": {"type": "string"}, "items": {"type": "array", "items": {"type": "object"}}}, "additionalProperties": true},
    "transform": {
      "type": "object",
      "properties": {
        "angle": {"type": "number", "minimum": -360, "maximum": 360},
        "flip_x": {"type": "boolean"}, "flip_y": {"type": "boolean"},
        "crop": {"type": "object", "properties": {
          "x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1},
          "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
        }, "additionalProperties": true}
      }, "additionalProperties": true
    },
    "review": {"type": "object", "required": ["id", "reason", "resolved", "alternatives"], "properties": {
      "id": {"type": "string", "minLength": 1}, "reason": {"type": "string"}, "resolved": {"type": "boolean"},
      "table": {"type": "string"}, "entity": {"type": "string"}, "field": {"type": "string", "pattern": "^/"},
      "alternatives": {"type": "array", "items": {"type": "object", "required": ["value"], "additionalProperties": true}}
    }, "additionalProperties": true}
  }
}
