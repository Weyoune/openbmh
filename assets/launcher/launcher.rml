<!-- SPDX-License-Identifier: GPL-3.0-only -->
<rml>
<head>
    <title>OpenBMH</title>
    <link type="text/rcss" href="theme.rcss"/>
</head>
<body>
    <img id="stadium" src="stadium.tga"/>
    <div class="shade"/>
    <div class="brand">
        <div class="pitch"><div class="halfway"/><div class="circle"/><div class="goal left"/><div class="goal right"/></div>
        <div class="wordmark">Open<span>BMH</span></div>
    </div>
    <div class="workspace">
        <div class="library panel">
            <h1>Deine Spiele</h1>
            <div class="subtitle">Bundesliga Manager Hattrick · Football Limited</div>
            <div class="table">
                <div class="column-head"><span class="name">Name</span><span class="type">Art</span></div>
                <div id="mod-list" tabindex="0"/>
            </div>
            <div id="mod-count" class="count">0 Mods</div>
        </div>
        <div class="actions panel">
            <button id="start" class="action primary" data-action="start" disabled="disabled"><span class="icon play"/><span>Start</span></button>
            <button id="add" class="action" data-action="add"><span class="icon plus"><span/></span><span>Add</span></button>
            <button id="delete" class="action" data-action="delete" disabled="disabled"><span class="icon bin"><span/></span><span>Delete</span></button>
            <button id="rename" class="action" data-action="rename" disabled="disabled"><span class="icon pencil"/><span>Rename</span></button>
            <button id="end" class="action" data-action="end"><span class="icon exit"><span/></span><span>End</span></button>
        </div>
    </div>
    <div id="version" class="version"/>
    <div id="overlay">
        <div id="modal" class="panel">
            <h2 id="modal-title"/>
            <div id="modal-body"/>
            <div id="modal-error"/>
            <div class="modal-buttons">
                <button id="cancel" data-action="cancel">Abbrechen</button>
                <button id="accept" class="primary" data-action="accept">OK</button>
            </div>
        </div>
    </div>
</body>
</rml>
