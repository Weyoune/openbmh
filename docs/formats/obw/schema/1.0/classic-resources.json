{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$comment": "SPDX-License-Identifier: GPL-3.0-only; Classic installation content.",
  "$id": "https://raw.githubusercontent.com/Weyoune/openbmh/main/docs/formats/obw/schema/1.0/classic-resources.json",
  "properties": {
    "schema": {
      "const": "classic-resources@1.0"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "pixels": {
            "type": "string"
          },
          "png": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "width",
          "height",
          "pixels",
          "png"
        ]
      }
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "height": {
            "type": "integer",
            "minimum": 0
          },
          "baseline": {
            "type": "integer",
            "minimum": 0
          },
          "nominal_width": {
            "type": "integer",
            "minimum": 0
          },
          "flags": {
            "type": "integer",
            "minimum": 0
          },
          "lo_char": {
            "type": "integer",
            "minimum": 0
          },
          "hi_char": {
            "type": "integer",
            "minimum": 0
          },
          "modulo": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string"
          },
          "bitmap": {
            "type": "string"
          },
          "glyphs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bit_offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "bit_width": {
                  "type": "integer",
                  "minimum": 0
                },
                "advance": {
                  "type": "integer"
                }
              },
              "required": [
                "bit_offset",
                "bit_width",
                "advance"
              ]
            }
          }
        },
        "required": [
          "name",
          "height",
          "baseline",
          "nominal_width",
          "flags",
          "lo_char",
          "hi_char",
          "modulo",
          "glyphs",
          "bitmap"
        ]
      },
      "minItems": 2,
      "maxItems": 2
    },
    "audio": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "codec": {
            "const": "original-alptraum@1"
          },
          "chunks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "id",
                "offset",
                "size"
              ]
            }
          }
        },
        "required": [
          "name",
          "path",
          "codec",
          "chunks"
        ]
      },
      "minItems": 4,
      "maxItems": 4
    },
    "optional": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "path"
        ]
      }
    }
  },
  "required": [
    "schema",
    "images",
    "fonts",
    "audio",
    "optional"
  ]
}
