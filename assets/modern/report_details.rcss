/* SPDX-License-Identifier: GPL-3.0-only */
/* Local to the 2612 x 1864 logical menu-content area, matching the HTML dialog layer. */
.report-detail-layer {position:absolute;left:0;top:0;width:100%;height:100%;z-index:30;display:flex;align-items:center;justify-content:center;background-color:#08101980;}
.report-detail-card {position:relative;flex-shrink:0;width:2484dp;height:860dp;border:2dp #e1ecf429;border-radius:22dp;background-color:#283542f5;color:#dce3e9;font-size:36dp;}
.report-detail-card h2 {position:absolute;left:52dp;right:52dp;top:40dp;height:48dp;line-height:48dp;margin:0;text-align:center;font-size:42dp;font-weight:bold;letter-spacing:-0.4dp;color:#eff0d6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.report-detail-badge {position:absolute;left:50%;top:123dp;width:220dp;height:220dp;margin-left:-110dp;padding:14dp;border-radius:18dp;background-color:#f4f6f8;overflow:hidden;}
.report-detail-note {position:absolute;left:52dp;right:52dp;top:371dp;height:42dp;line-height:42dp;margin:0;text-align:center;font-size:28dp;color:#a4b5c5;}
.report-detail-values {display:block;position:absolute;left:52dp;right:52dp;top:448dp;height:258dp;margin:0;}
.report-detail-field {position:absolute;left:0;right:0;height:42dp;}
.report-detail-values dt,.report-detail-values dd {display:block;position:absolute;top:0;height:42dp;line-height:42dp;margin:0;font-size:36dp;white-space:normal;}
.report-detail-values dt {left:0;width:1173dp;}
.report-detail-values dd {right:0;width:1173dp;text-align:right;color:#f7e7ac;}
.report-detail-actions {position:absolute;left:52dp;right:52dp;bottom:40dp;height:65dp;display:flex;gap:70dp;}
.report-detail-actions .report-detail-action {flex:1;min-width:0;height:65dp;padding:12dp 24dp;border:2dp #d4e0ec29;border-radius:12dp;background-color:transparent;decorator:linear-gradient(180deg,#c1d1e31c,#869eb312);font-size:32dp;line-height:37dp;font-weight:normal;color:#e0e6ec;}
.report-detail-actions .report-detail-action:hover {decorator:none;background-color:#d0e2f226;}
.report-detail-actions .report-detail-action:focus-visible {border-color:var(--accent);}
.report-detail-roster {height:1227dp;}
.report-detail-roster-scroll {position:absolute;left:52dp;right:52dp;top:123dp;height:950dp;overflow:auto;}
.report-detail-table {display:table;width:100%;font-size:34dp;color:#d7e5cf;}
.report-detail-row {display:table-row;}
.report-detail-cell {display:table-cell;width:16%;height:66dp;padding:6dp 16dp;vertical-align:middle;text-align:right;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.report-detail-cell:first-child {width:52%;text-align:left;}
.report-detail-table-head {color:#91bd72;}
.report-detail-table-head .report-detail-cell {border-bottom:4dp #4e8b7b;}
.report-detail-striped {background-color:#38706b19;}
.report-detail-player-link {max-width:100%;padding:2dp 6dp;border:0dp;border-radius:0dp;background-color:transparent;font-size:34dp;text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.report-detail-player-link.control-button {justify-content:flex-start;}
.report-detail-player-link:hover {background-color:#ffffff1a;}
.report-detail-player-link:focus-visible {color:var(--accent);background-color:var(--selected);}
.report-detail-empty {margin-top:30dp;text-align:center;color:var(--muted);font-size:32dp;}
.report-detail-player {width:1960dp;height:988.667dp;}
.report-detail-player h2 {color:#e5edf3;}
.report-detail-portrait {position:absolute;left:52dp;top:123dp;width:500dp;height:666.667dp;border:2dp #c5d9e72b;border-radius:18dp;overflow:hidden;}
.report-detail-photo-caption {position:absolute;left:52dp;top:807.667dp;width:500dp;height:27dp;line-height:27dp;margin:0;text-align:center;font-size:23dp;color:#a8bece;}
.report-detail-player .report-detail-values {left:612dp;right:52dp;top:314.333dp;height:329dp;}
.report-detail-player .report-detail-field,.report-detail-player .report-detail-values dt,.report-detail-player .report-detail-values dd {height:37dp;line-height:37dp;font-size:32dp;}
.report-detail-player .report-detail-values dt {width:220dp;}
.report-detail-player .report-detail-values dd {width:1047dp;color:#d6e5ed;}
body.silver .report-detail-card {background-color:#eaf1f7fc;border-color:var(--border);color:var(--text);}
body.matchday .report-detail-card {background-color:#2c2c32fc;border-color:var(--border);color:var(--text);}
body.silver .report-detail-card h2,body.matchday .report-detail-card h2 {color:var(--text);}
body.silver .report-detail-values dd,body.matchday .report-detail-values dd {color:var(--accent);}
body.silver .report-detail-player .report-detail-values dd,body.matchday .report-detail-player .report-detail-values dd {color:var(--text);}
body.silver .report-detail-photo-caption,body.matchday .report-detail-photo-caption {color:var(--text);}
body.silver .report-detail-actions .report-detail-action {border-color:var(--border);color:var(--text);decorator:linear-gradient(180deg,#ffffffb0,#bfd0e259);}
body.matchday .report-detail-actions .report-detail-action {border-color:var(--border);color:var(--text);decorator:linear-gradient(180deg,#e8d6dc12,#a1a0aa0d);}
body.silver .report-detail-actions .report-detail-action:hover,body.matchday .report-detail-actions .report-detail-action:hover {decorator:none;background-color:var(--hover);}
body.silver .report-detail-table,body.matchday .report-detail-table {color:var(--text);}
body.silver .report-detail-striped {background-color:#42627d09;}
body.matchday .report-detail-striped {background-color:#f8e7e00a;}
