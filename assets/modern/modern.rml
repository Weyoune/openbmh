<rml><head><title>OpenBMH Modern</title><link type="text/rcss" href="../launcher/theme.rcss"/><link type="text/rcss" href="modern.rcss"/></head>
<body>
<img id="stadium" src="../launcher/stadium.tga"/><div class="modern-shade"/>
<div class="topbar"><div class="modern-brand">Open<span>BMH</span><span class="edition">MODERN</span></div><div class="top-actions"><button id="new" data-action="new"><span>Neue Karriere</span></button><button id="load" data-action="load"><span>Laden</span></button><button id="save" data-action="save"><span>Speichern</span></button><button id="quit" data-action="quit"><span>Launcher</span></button></div></div>
<div class="shell"><div class="sidebar panel"><div class="nav-label">DEIN VEREIN</div><button id="nav-office" class="nav selected" data-action="nav:office"><span>Büro</span></button><button id="nav-lineup" class="nav" data-action="nav:lineup"><span>Aufstellung</span></button><button class="nav" disabled="disabled"><span>Training</span><span class="later">später</span></button><button class="nav" disabled="disabled"><span>Transfer</span><span class="later">später</span></button><button class="nav" disabled="disabled"><span>Finanzen</span><span class="later">später</span></button><button class="nav" disabled="disabled"><span>Stadion</span><span class="later">später</span></button><button id="nav-table" class="nav" data-action="nav:table"><span>Tabelle</span></button><div class="sidebar-note">Vorbereitungs-POC<br/>Spieltag und weitere Bereiche folgen.</div></div>
<div class="main"><div id="club-header" class="club-header panel"/><div class="page-heading"><div><h1 id="page-title">Willkommen im Verein</h1><div id="page-subtitle" class="subtitle">Deine Karriere. Dein Spiel.</div></div><div id="career-status" class="career-status"/></div><div id="content" class="content"/></div></div>
<div id="version" class="version"/>
<div id="overlay"><div id="modal" class="panel"><h2 id="modal-title"/><div id="modal-body"/><div id="modal-error"/><div class="modal-buttons"><button id="cancel" data-action="cancel"><span>Abbrechen</span></button><button id="discard" data-action="discard"><span>Verwerfen</span></button><button id="accept" class="primary" data-action="accept"><span>OK</span></button></div></div></div>
</body></rml>
