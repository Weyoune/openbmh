/* SPDX-License-Identifier: GPL-3.0-only */
/* The submenu palettes are shared by every surface and control. RmlUI 6.3
   resolves these inherited custom properties when the body class changes. */
body {
 --text: #dce3e9;
 --muted: #a8b8c8;
 --accent: #a9dccb;
 --window-top: #303c49;
 --window-bottom: #1a2531;
 --chrome: #d5e3ed0a;
 --sidebar: #111a2426;
 --panel: #111a2433;
 --wash: #e3edf605;
 --control-top: #c1d1e31c;
 --control-bottom: #869eb312;
 --input: #17232e99;
 --popup: #293744;
 --hover: #d0e2f226;
 --selected: #a9d4c526;
 --selected-hover: #a9d4c53d;
 --selected-text: #e8f5ef;
 --border: #e2ebf02b;
 --divider: #d4e1eb12;
 --accent-border: #a9d4c55c;
 --focus: #8cc8ff;
 --danger: #f0aaa7;
 --danger-border: #f0aaa75c;
 --warning: #e1c68b;
 --positive: #b5dfcf;
 --note: #a9d4c50a;
 --modal: #283542;
 --overlay: #0b11189c;
 --image-stage: #1b2733;
 --crop: #a9dccb;
 --crop-wash: #a9dccb16;
 --scrollbar: #a8b8c860;
 --scrollbar-hover: #a8b8c899;
 --toggle-off: #617483;
 --toggle-on: #a9dccb;
 margin: 0; width: 100%; height: 100%; overflow: hidden;
 font-family: LatoLatin; font-size: 15dp; color: var(--text);
 background-color: var(--window-bottom);
 decorator: linear-gradient(155deg, var(--window-top), var(--window-bottom));
}
body.silver {
 --text: #233443;
 --muted: #526779;
 --accent: #25617a;
 --window-top: #f0f5f9;
 --window-bottom: #d4e0ea;
 --chrome: #ffffff45;
 --sidebar: #42627d09;
 --panel: #f1f6fa80;
 --wash: #42627d09;
 --control-top: #ffffffb0;
 --control-bottom: #bfd0e259;
 --input: #ffffffad;
 --popup: #f3f7fc;
 --hover: #9eb9d43b;
 --selected: #a3c3dd54;
 --selected-hover: #a3c3dd88;
 --selected-text: #193b52;
 --border: #6c879c4a;
 --divider: #6c879c28;
 --accent-border: #356f966e;
 --focus: #2b729a;
 --danger: #a23f45;
 --danger-border: #a23f4566;
 --warning: #805b18;
 --positive: #2e6953;
 --note: #2e69530a;
 --modal: #eaf1f7;
 --overlay: #21324166;
 --image-stage: #cfdae3;
 --crop: #25617a;
 --crop-wash: #25617a16;
 --scrollbar: #6c879c88;
 --scrollbar-hover: #526779bb;
 --toggle-off: #91a8b8;
 --toggle-on: #25617a;
}
body.matchday {
 --text: #efeded;
 --muted: #b7b4b9;
 --accent: #efb2aa;
 --window-top: #343338;
 --window-bottom: #202126;
 --chrome: #ffffff07;
 --sidebar: #1d1e2426;
 --panel: #1d1e2466;
 --wash: #f8e7e00a;
 --control-top: #e8d6dc12;
 --control-bottom: #a1a0aa0d;
 --input: #191a208a;
 --popup: #303037;
 --hover: #d5b3b423;
 --selected: #d48c7b26;
 --selected-hover: #d48c7b3d;
 --selected-text: #ffe5de;
 --border: #ead9da29;
 --divider: #ead9da16;
 --accent-border: #e5a19770;
 --focus: #efb2aa;
 --danger: #f0a6a7;
 --danger-border: #f0a6a75c;
 --warning: #e1c68b;
 --positive: #afd1be;
 --note: #afd1be0a;
 --modal: #2c2c32;
 --overlay: #1111149c;
 --image-stage: #23242a;
 --crop: #efb2aa;
 --crop-wash: #efb2aa16;
 --scrollbar: #827c8199;
 --scrollbar-hover: #b7b4b999;
 --toggle-off: #68646c;
 --toggle-on: #efb2aa;
}
* { box-sizing: border-box; }
div, h1, h2, p, label, header, aside, section, footer { display: block; }
span { display: inline-block; }
#shell { width: 100%; height: 100%; display: flex; flex-direction: column; }
header { height: 86dp; flex-shrink: 0; display: flex; align-items: center; padding: 0 28dp; background-color: var(--chrome); border-bottom: 1dp var(--border); }
.brand { display: flex; align-items: center; width: 300dp; }
.brand-mark { width: 43dp; height: 43dp; line-height: 43dp; font-size: 21dp; font-weight: bold; text-align: center; border: 1dp var(--accent-border); border-radius: 13dp; color: var(--accent); background-color: var(--wash); margin-right: 13dp; }
.brand-mark span { color: var(--text); }
h1, h2, p { margin: 0; }
h2 { font-size: 20dp; font-weight: bold; }
h2 span { font-weight: normal; color: var(--muted); }
small { display: block; font-size: 12dp; color: var(--muted); margin-top: 4dp; }
#world-caption { flex: 1; font-size: 14dp; color: var(--muted); overflow: hidden; white-space: nowrap; }
#top-actions, #bottom-actions, #page-actions, .button-row { display: flex; align-items: center; gap: 8dp; }
button { font-family: LatoLatin; font-size: 14dp; color: var(--text); background-color: transparent; decorator: linear-gradient(var(--control-top), var(--control-bottom)); border: 1dp var(--border); border-radius: 8dp; padding: 9dp 14dp; cursor: pointer; text-align: center; white-space: nowrap; tab-index: auto; }
button:hover { background-color: var(--hover); decorator: none; }
button.primary { background-color: var(--selected); decorator: none; color: var(--selected-text); border-color: var(--accent-border); font-weight: bold; }
button.primary:hover { background-color: var(--selected-hover); }
button.danger { color: var(--danger); border-color: var(--danger-border); }
button:disabled { opacity: 0.35; cursor: unavailable; }
button.quiet { border-color: transparent; background-color: transparent; decorator: none; }
button.quiet:hover { background-color: var(--hover); }
#main { flex: 1; display: flex; min-height: 0; }
aside { width: 220dp; flex-shrink: 0; padding: 28dp 14dp 18dp; display: flex; flex-direction: column; background-color: var(--sidebar); border-right: 1dp var(--divider); }
.eyebrow { font-size: 11dp; font-weight: bold; letter-spacing: 1.5dp; color: var(--muted); text-transform: uppercase; }
#nav-label { padding: 0 14dp 18dp; }
#navigation { display: flex; flex-direction: column; gap: 5dp; min-height: 0; overflow-y: auto; }
.nav { width: 100%; display: flex; align-items: center; padding: 11dp 13dp; text-align: left; border-color: transparent; background-color: transparent; decorator: none; font-size: 15dp; }
.nav .glyph { width: 20dp; height: 20dp; margin-right: 16dp; flex-shrink: 0; }
.nav.selected { background-color: var(--selected); color: var(--accent); border-color: var(--accent-border); }
.aside-foot { margin-top: auto; padding: 24dp 14dp 0; font-size: 12dp; color: var(--muted); }
.aside-foot small { line-height: 1.45; }
.small-pitch { height: 50dp; width: 84dp; border: 1dp var(--border); border-radius: 4dp; margin-bottom: 15dp; position: relative; }
.small-pitch div { position: absolute; width: 20dp; height: 20dp; border: 1dp var(--border); border-radius: 10dp; left: 31dp; top: 14dp; }
#workspace { flex: 1; padding: 28dp 30dp 16dp; display: flex; flex-direction: column; min-width: 0; }
#page-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 23dp; flex-shrink: 0; }
h1 { font-size: 28dp; font-weight: bold; margin-top: 7dp; }
#page-subtitle { color: var(--muted); margin-top: 7dp; font-size: 14dp; }
#toolbar { display: flex; gap: 10dp; margin-bottom: 16dp; flex-shrink: 0; align-items: center; }
input, select, textarea { font-family: LatoLatin; font-size: 14dp; background-color: var(--input); color: var(--text); border: 1dp var(--border); border-radius: 7dp; padding: 9dp 10dp; height: 38dp; tab-index: auto; }
input[type=checkbox] { width: 18dp; height: 18dp; padding: 2dp; background-color: var(--toggle-off); }
input[type=checkbox]:checked { background-color: var(--toggle-on); decorator: none; }
input[type=range] { height: 24dp; padding: 0; }
input[type=range] track { height: 4dp; background-color: var(--scrollbar); margin: 9dp 0; border-radius: 2dp; }
input[type=range] bar { width: 16dp; height: 16dp; border-radius: 8dp; background-color: var(--accent); margin-top: 3dp; }
/* Modern Desktop pickers, in density-independent editor dimensions. The
   native RmlUI controls retain their values, input and change events. */
select { padding-right: 30dp; cursor: pointer; background-color: transparent; decorator: linear-gradient(var(--control-top), var(--control-bottom)); box-shadow: inset 0 1dp #eff6fc12, 0 1dp 2dp #0002; }
select:hover { background-color: var(--hover); decorator: none; }
select selectvalue { padding: 0; }
/* RmlUI anchors the arrow to the content box. Use the reserved right padding
   and center the rotated glyph within the control's 18dp content height. */
select selectarrow { width: 8dp; height: 8dp; margin-right: -15dp; margin-top: 3dp; decorator: none; border-bottom: 1.5dp var(--muted); border-right: 1.5dp var(--muted); transform: rotate(45deg); }
select selectbox { width: 100%; min-width: 180dp; background-color: var(--popup); color: var(--text); border: 1dp var(--border); border-radius: 9dp; padding: 5dp; margin-top: 7dp; margin-bottom: 7dp; max-height: 320dp; overflow-y: auto; box-shadow: 0 9dp 28dp #0008; }
select option { display: flex; align-items: center; min-height: 34dp; padding: 5dp 7dp; border-radius: 5dp; white-space: nowrap; cursor: pointer; }
select option:hover { background-color: var(--hover); }
select option:disabled { opacity: 0.35; cursor: unavailable; }
.option-check { width: 6dp; height: 10dp; margin: 0 12dp 3dp 3dp; flex-shrink: 0; border-right: 1.5dp var(--accent); border-bottom: 1.5dp var(--accent); transform: rotate(45deg); opacity: 0; }
option:checked .option-check { opacity: 1; }
selectvalue .option-check { display: none; }
.option-label { overflow: hidden; text-overflow: ellipsis; }
.option-label, .option-check { pointer-events: none; focus: none; }
#search { width: 250dp; margin-right: auto; }
#filter-nation, #filter-league { width: 205dp; }
#filter-team { width: 240dp; }
#page-content { flex: 1; min-height: 0; display: flex; }
.split { width: 100%; display: flex; gap: 20dp; min-height: 0; }
.list-panel { flex: 1; min-width: 0; border: 1dp var(--border); border-radius: 12dp; overflow: hidden; background-color: var(--panel); display: flex; flex-direction: column; }
.table-header { display: flex; align-items: center; height: 42dp; flex-shrink: 0; padding: 0 16dp; background-color: var(--wash); border-bottom: 1dp var(--divider); }
.table-header button { flex: 1; text-align: left; padding: 0; border: 0; background-color: transparent; decorator: none; font-size: 12dp; color: var(--muted); }
.table-header button:hover { color: var(--text); }
.table-header button:first-child { flex: 2; }
.table-scroll { flex: 1; overflow-y: auto; }
.comparison-layout { flex: 1; display: flex; flex-direction: column; min-width: 0; min-height: 0; }
.comparison-bar { display: flex; align-items: center; gap: 12dp; margin-bottom: 14dp; flex-shrink: 0; }
.comparison-bar label, .comparison-bar span { color: var(--muted); font-size: 12dp; }
.comparison-bar span { margin-left: auto; }
#comparison-set { width: 310dp; }
.comparison-panel { min-height: 0; }
.comparison-x { flex: 1; min-height: 0; overflow-x: auto; overflow-y: hidden; display: flex; }
.comparison-table { flex-shrink: 0; display: flex; flex-direction: column; min-height: 0; }
.comparison-head { display: flex; flex-shrink: 0; align-items: stretch; background-color: var(--wash); border-bottom: 1dp var(--border); padding-right: 20dp; }
.comparison-head button { border: 0; border-radius: 0; decorator: none; background-color: transparent; color: var(--muted); font-size: 13dp; padding: 12dp 10dp; white-space: normal; }
.comparison-head button:disabled { opacity: 1; cursor: default; }
.comparison-head small { font-size: 11dp; }
.comparison-direction { width: 7dp; height: 7dp; border-bottom: 1.5dp var(--accent); border-right: 1.5dp var(--accent); transform: rotate(45deg); margin-left: 8dp; margin-bottom: 3dp; }
.comparison-direction.ascending { transform: rotate(225deg); margin-bottom: 0; }
.comparison-body { flex: 1; min-height: 0; overflow-y: auto; }
.comparison-row { display: flex; align-items: center; border: 0; border-bottom: 1dp var(--divider); border-radius: 0; decorator: none; background-color: transparent; padding: 0; min-height: 47dp; text-align: left; }
.comparison-cell { flex-shrink: 0; padding: 14dp 10dp; text-align: right; font-size: 14dp; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.comparison-cell.text { text-align: left; }
.comparison-name-text { display: block; overflow: hidden; text-overflow: ellipsis; }
.comparison-note { flex-shrink: 0; margin-top: 12dp; font-size: 12dp; line-height: 1.6; color: var(--muted); }
.comparison-choices { display: flex; flex-wrap: wrap; max-height: 430dp; overflow-y: auto; margin-top: 16dp; gap: 6dp; }
.comparison-choices label { width: 31%; display: flex; align-items: center; padding: 10dp 4dp; font-size: 14dp; }
.comparison-choices input { flex-shrink: 0; margin-right: 10dp; border-radius: 4dp; }
.record { display: flex; align-items: center; width: 100%; min-height: 49dp; padding: 9dp 16dp; border: 0; border-bottom: 1dp var(--divider); border-radius: 0; background-color: transparent; decorator: none; text-align: left; }
.record:hover { background-color: var(--hover); }
.record.selected { background-color: var(--selected); border-left: 3dp var(--accent); padding-left: 13dp; }
.record .cell { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding-right: 10dp; font-size: 13dp; color: var(--muted); }
.record .cell:first-child { flex: 2; font-size: 14dp; color: var(--text); display: flex; align-items: center; }
.record.selected .cell { color: var(--selected-text); }
.mini-logo { width: 27dp; height: 27dp; margin-right: 12dp; flex-shrink: 0; }
.inspector { width: 370dp; flex-shrink: 0; border: 1dp var(--border); border-radius: 12dp; background-color: var(--panel); display: flex; flex-direction: column; overflow: hidden; }
.inspector-head { padding: 22dp; border-bottom: 1dp var(--divider); display: flex; align-items: center; flex-shrink: 0; }
.hero-image { width: 70dp; height: 70dp; margin-right: 16dp; }
.inspector-head h2 { font-size: 19dp; }
.inspector-head small { font-size: 10dp; margin-top: 7dp; }
.inspector-scroll { flex: 1; overflow-y: auto; padding: 20dp 22dp; }
.form-field { margin-bottom: 15dp; }
.form-field label { display: block; font-size: 12dp; color: var(--muted); margin-bottom: 6dp; }
.form-field input, .form-field select, .form-field textarea { width: 100%; }
textarea { height: 110dp; font-size: 12dp; line-height: 1.5; }
.form-section { padding-top: 8dp; margin-bottom: 15dp; font-size: 12dp; font-weight: bold; color: var(--accent); }
.form-help { font-size: 11dp; color: var(--muted); line-height: 1.5; margin-top: 6dp; }
.connection-actions { margin-top: 20dp; }
.inspector-actions { padding: 16dp 20dp; border-top: 1dp var(--divider); display: flex; gap: 8dp; flex-shrink: 0; }
.inspector-actions button { flex: 1; }
.empty { margin: auto; padding: 45dp; text-align: center; color: var(--muted); line-height: 1.7; }
#pagination { display: flex; justify-content: space-between; align-items: center; flex-shrink: 0; padding-top: 14dp; color: var(--muted); font-size: 12dp; }
footer { height: 57dp; padding: 0 28dp; display: flex; align-items: center; gap: 20dp; flex-shrink: 0; border-top: 1dp var(--divider); background-color: var(--sidebar); font-size: 12dp; }
#state { width: 210dp; color: var(--positive); }
#status-message { flex: 1; color: var(--muted); }
#bottom-actions button { font-size: 12dp; padding: 7dp 11dp; }
.dashboard { width: 100%; overflow-y: auto; padding-right: 7dp; }
.hero { padding: 32dp; border: 1dp var(--border); border-radius: 16dp; background-color: var(--wash); margin-bottom: 22dp; }
.hero h1 { font-size: 32dp; margin: 0 0 12dp; }
.hero p { color: var(--muted); line-height: 1.6; max-width: 700dp; margin-bottom: 23dp; }
.metrics { display: flex; flex-wrap: wrap; gap: 14dp; }
.metric { width: 23%; flex-grow: 1; min-width: 180dp; min-height: 106dp; padding: 20dp; border: 1dp var(--border); border-radius: 12dp; background-color: var(--panel); decorator: none; text-align: left; }
.metric span { display: block; font-size: 28dp; font-weight: bold; color: var(--text); margin-top: 9dp; }
.note { margin-top: 22dp; padding: 18dp 20dp; background-color: var(--note); border: 1dp var(--accent-border); border-radius: 10dp; color: var(--positive); font-size: 13dp; line-height: 1.6; }
.source-json { font-size: 11dp; line-height: 1.5; white-space: pre-wrap; color: var(--muted); margin: 14dp 0; }
.regulation-layout { flex: 1; display: flex; gap: 20dp; min-width: 0; min-height: 0; }
.regulation-list { width: 270dp; flex: none; }
.regulation-choice { display: block; width: 100%; text-align: left; white-space: normal; padding: 15dp 18dp; border-radius: 0; border: 0; border-bottom: 1dp var(--divider); }
.regulation-choice small { font-size: 11dp; }
.regulation-detail { min-width: 0; }
.regulation-scroll { flex: 1; overflow-y: auto; padding: 25dp; }
.regulation-scroll p { margin-top: 12dp; font-size: 15dp; line-height: 1.55; }
.regulation-scroll h2 { line-height: 1.4; }
.regulation-section { margin: 27dp 0; padding-top: 22dp; border-top: 1dp var(--divider); }
.regulation-section h2 { font-size: 18dp; margin-bottom: 13dp; }
.regulation-clause { padding: 15dp 18dp; border: 1dp var(--border); border-radius: 10dp; background-color: var(--wash); margin-bottom: 12dp; }
.regulation-clause p { margin-top: 8dp; }
.regulation-scroll .source-json { font-size: 13dp; line-height: 1.55; }
.history-row, .diagnostic { padding: 15dp 20dp; border-bottom: 1dp var(--divider); line-height: 1.6; }
.diagnostic.error { color: var(--danger); }
.diagnostic.warning { color: var(--warning); }
.badge { display: inline-block; font-size: 11dp; border: 1dp var(--accent-border); color: var(--positive); border-radius: 5dp; padding: 3dp 6dp; }
#overlay { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: var(--overlay); align-items: center; justify-content: center; }
#modal { width: 620dp; max-height: 91%; padding: 27dp; border: 1dp var(--border); border-radius: 18dp; background-color: var(--modal); display: flex; flex-direction: column; }
#modal.wide { width: 880dp; }
.modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 22dp; flex-shrink: 0; }
.close { padding: 0 7dp; background-color: transparent; decorator: none; border-color: transparent; font-size: 25dp; }
#modal-content { overflow-y: auto; line-height: 1.6; }
#modal-buttons { margin-top: 23dp; display: flex; justify-content: flex-end; gap: 9dp; flex-shrink: 0; }
#modal-error { color: var(--danger); font-size: 13dp; margin-top: 10dp; }
#history-overlay { display: none; position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 10; }
#history-menu { position: absolute; width: 248dp; padding: 6dp; border: 1dp var(--border); border-radius: 10dp; background-color: var(--popup); }
#history-menu button { width: 100%; display: flex; align-items: center; text-align: left; padding: 10dp; border-color: transparent; decorator: none; font-size: 15dp; }
.history-arrow { width: 28dp; flex-shrink: 0; display: flex; align-items: center; }
.history-arrow .glyph { width: 20dp; height: 20dp; }
#history-menu small { margin: 0 0 0 auto; padding-left: 16dp; }
.image-layout { display: flex; gap: 24dp; }
.image-stage { flex: 1; min-height: 360dp; background-color: var(--image-stage); border: 1dp var(--border); border-radius: 10dp; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.hero-image, .mini-logo { cursor: pointer; }
.readonly-stage { height: 500dp; }
.image-caption { margin-top: 12dp; word-break: break-all; }
#crop-canvas { position: relative; }
#edit-preview { display: block; }
#crop-box { position: absolute; border: 2dp var(--crop); background-color: var(--crop-wash); pointer-events: none; }
.image-controls { width: 215dp; }
.pair { display: flex; gap: 8dp; }
.pair .form-field { flex: 1; min-width: 0; }
.check-label { display: flex; align-items: center; gap: 10dp; font-size: 14dp; margin: 14dp 0; }
scrollbarvertical { width: 7dp; margin: 3dp; }
scrollbarvertical slidertrack { background-color: transparent; }
scrollbarvertical sliderbar { background-color: var(--scrollbar); border-radius: 4dp; min-height: 30dp; }
scrollbarvertical sliderbar:hover { background-color: var(--scrollbar-hover); }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { height: 0; }
scrollbarhorizontal { height: 10dp; margin: 3dp; }
scrollbarhorizontal slidertrack { background-color: transparent; }
scrollbarhorizontal sliderbar { background-color: var(--scrollbar); border-radius: 4dp; min-width: 40dp; }
scrollbarhorizontal sliderbar:hover { background-color: var(--scrollbar-hover); }
scrollbarhorizontal sliderarrowdec, scrollbarhorizontal sliderarrowinc { width: 0; }
button:focus, input:focus, select:focus, textarea:focus { border-color: var(--focus); }
.nav:focus { border-color: var(--focus); }
