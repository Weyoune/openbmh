{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Weyoune/openbmh/main/docs/formats/obw/schema/1.0/calendar.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "calendar@1.0"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^calendar:[a-zA-Z0-9._-]+$"
          },
          "season_start": {
            "const": "07-01"
          },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "legacy_calendar_bit": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 31
                }
              },
              "required": [
                "id",
                "legacy_calendar_bit"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "id",
          "season_start",
          "series"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema",
    "items"
  ],
  "additionalProperties": true,
  "$comment": "SPDX-License-Identifier: GPL-3.0-only; initial legacy-database-v1 conversion profile."
}
