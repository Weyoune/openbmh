{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Weyoune/openbmh/main/docs/formats/obw/schema/1.0/classic-bytes.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "classic-bytes@1.0"
    },
    "hex": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{2})*$",
      "maxLength": 33554432
    }
  },
  "required": [
    "schema",
    "hex"
  ],
  "additionalProperties": false
}
