{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Weyoune/openbmh/main/docs/formats/obw/schema/1.0/classic-driver.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "classic-driver@1.0"
    },
    "stage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2
    },
    "calendar_entry": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "manager_position": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "next_event_id": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20
    },
    "loaded_matchday_resume": {
      "type": "boolean"
    },
    "suppress_remaining_pre_match_offers": {
      "type": "boolean"
    },
    "national_nomination_desk": {
      "type": "boolean"
    },
    "enable_national_nomination_desks": {
      "type": "boolean"
    },
