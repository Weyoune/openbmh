<rml>
<head><title>OpenBMH Editor</title><link type="text/rcss" href="theme.rcss"/></head>
<body id="app" class="midnight">
  <div id="shell">
    <header><div class="brand"><div class="brand-mark">O<span>B</span></div><div><h2>OpenBMH <span>Editor</span></h2><small id="tagline"></small></div></div><div id="world-caption"></div><div id="top-actions"></div></header>
    <div id="main"><aside><div class="eyebrow" id="nav-label"></div><div id="navigation"></div><div class="aside-foot"><div class="small-pitch"><div></div></div><span>OBW 1.1</span><small id="profile-note"></small></div></aside>
      <section id="workspace"><div id="page-heading"><div><div class="eyebrow" id="page-kicker"></div><h1 id="page-title"></h1><p id="page-subtitle"></p></div><div id="page-actions"></div></div>
      <div id="toolbar"></div><div id="page-content"></div><div id="pagination"></div></section>
    </div>
    <footer><div id="state"></div><div id="status-message"></div><div id="bottom-actions"></div></footer>
  </div>
  <div id="overlay"><div id="modal"><div class="modal-head"><h2 id="modal-title"></h2><button data-action="cancel-modal" class="close">×</button></div><div id="modal-content"></div><div id="modal-error"></div><div id="modal-buttons"></div></div></div>
</body></rml>
